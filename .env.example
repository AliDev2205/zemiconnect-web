# URL de l API Laravel (sans /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:8000

# true : les services renvoient les donnees de src/mocks au lieu d appeler l API.
NEXT_PUBLIC_API_MOCK=false

# Origine publique des QR imprimés (<origine>/v/<jeton>). Le scanner agent refuse toute autre origine.
NEXT_PUBLIC_PUBLIC_URL=http://localhost:3000
